# HTTPS hostnames the agent VM may reach. Matched against TLS SNI by
# mitmproxy (so SNI-spoofing inside an allowed CONNECT tunnel is caught).
# fnmatch syntax: `*` matches any chars except `.`-style separators in
# Python's fnmatch — i.e. `*.example.com` matches `foo.example.com` but
# NOT `example.com`. List both forms when you want both.
#
# Optional scoped form:
#   host_glob python_regex
#
# The regex is matched against `METHOD /path?query` after TLS is
# decrypted. Example for HTTPS Git access to selected GitHub repos only:
#   github.com ^(GET|POST) /owner/(repo1|repo2)\.git/
#
# Edit this file then run `./rootcell allow` to hot-reload (no rebuild).

# AWS Bedrock (the agent's LLM provider)
bedrock-runtime.*.amazonaws.com

# Claude Code binary source used by pinned nixpkgs if the Nix cache misses.
storage.googleapis.com ^(GET|HEAD) /claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/2\.1\.141/linux-arm64/claude(?:\?.*)?$

# Cursor Agent CLI binary source used by pinned nixpkgs if the Nix cache misses.
downloads.cursor.com ^(GET|HEAD) /lab/2026\.05\.07-42ddaca/linux/arm64/agent-cli-package\.tar\.gz(?:\?.*)?$
# Cursor Agent CLI runtime self-update source.
downloads.cursor.com ^(GET|HEAD) /lab/2026\.05\.24-dda726e/linux/arm64/agent-cli-package\.tar\.gz(?:\?.*)?$

# Cursor Agent CLI API.
api.cursor.com
api.cursor.sh
*.cursor.sh

# OpenAI Codex / ChatGPT Plus-Pro subscription auth
auth.openai.com
chatgpt.com

# GitHub (clones, releases, raw content)
github.com
api.github.com
codeload.github.com
*.githubusercontent.com
objects.githubusercontent.com

# GitLab (mirrors github coverage)
gitlab.com

# Bitbucket
bitbucket.org
*.bitbucket.org

# Azure DevOps (Repos, Pipelines, Artifacts)
dev.azure.com
*.dev.azure.com
ssh.dev.azure.com
*.visualstudio.com

# Nix binary caches and channels
cache.nixos.org
channels.nixos.org
*.cloudfront.net
*.cachix.org

# Language package registries
registry.npmjs.org
*.npmjs.org
pypi.org
files.pythonhosted.org
*.crates.io
proxy.golang.org
sum.golang.org
